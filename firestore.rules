rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    match /players/{id} {
      allow read: if true;
      allow delete: if request.auth != null && id.matches(request.auth.uid + '_.*');
      allow create, update: if request.auth != null
        && id.matches(request.auth.uid + '_.*')
        && request.resource.data.keys().hasOnly(['name','avatar','xp','weekXp','week','trophies','streak','updated'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 16
        && request.resource.data.xp is int && request.resource.data.xp >= 0
        && request.resource.data.weekXp is int && request.resource.data.weekXp <= request.resource.data.xp
        && request.resource.data.updated == request.time
        && (resource == null ? request.resource.data.xp <= 20000
                             : request.resource.data.xp - resource.data.xp <= 3000);
    }
  }
}
